{
  "expo": {
    "name": "Distravel",
    "slug": "distravel",
    "version": "8.0.2",
    "orientation": "portrait",
    "icon": "./assets/logo_official.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/logo_official.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A192F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.distravel.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "platforms": ["android", "ios"],
    "android": {
      "package": "com.distravel.app",
      "versionCode": 9,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_official.png",
        "backgroundColor": "#0A192F"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },

    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "6c983860-4300-4f53-9ffc-d128e8803dce"
      }
    }
  }
}
